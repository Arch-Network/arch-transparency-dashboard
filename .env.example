# Network to serve: mainnet (default) or testnet
# ARCH_NETWORK=mainnet

# Arch Prime Analytics API base URL (public mainnet default)
# ANALYTICS_BASE_URL=https://apid-mainnet.up.railway.app

# Optional override for the Prime Transparency / Theya BTC endpoint
# (`/v1/prime-transparency`). Defaults to ANALYTICS_BASE_URL on mainnet and is
# disabled on testnet (Theya roster scanning is mainnet-only). Set to "off" to
# disable the Theya section explicitly.
# PRIME_TRANSPARENCY_API_BASE=https://apid-mainnet.up.railway.app

# Optional Bearer token if PRIME_TRANSPARENCY_API_BASE points to a gated proxy.
# Not required for the public Arch Prime Analytics API.
# THEYA_API_TOKEN=

# Arch Explorer API base URL and optional API key
# EXPLORER_BASE_URL=https://explorer.arch.network/api/v1/mainnet
# EXPLORER_API_KEY=

# Arch mainnet RPC URL (used for reading bridge program settings on mainnet)
# ARCH_RPC_URL=https://rpc.mainnet.arch.network

# Start of history for daily charts (ISO 8601 UTC)
# HISTORY_START=2026-10-15T00:00:00Z

# Set to "false" at build time to hide the ArchUSD tab
# VITE_FEATURE_ARCHUSD=true
